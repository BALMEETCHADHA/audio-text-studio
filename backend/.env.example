# Copy this file to .env and fill in your own values. Never commit the real .env file.
#
# This app is ENGLISH ONLY: audio in any other language is refused with a message.

# ── Pick ONE setup ──────────────────────────────────────────────────────

# SETUP A — FREE, hosted, best for a live website (recommended)
#   Groq runs Whisper (transcript) AND a gpt-oss model (summary + AI insights).
#   Get a free key at https://console.groq.com  (no card needed). Free-tier limits apply
#   (rate limits, 25 MB per audio file, no uptime guarantee).
TRANSCRIPTION_BACKEND=openai
ANALYSIS_BACKEND=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_paste-your-groq-key-here
# whisper-large-v3 is the most accurate Whisper on Groq (best for names and technical words).
# whisper-large-v3-turbo is faster but makes noticeably more mistakes — use it only if you need speed.
TRANSCRIBE_MODEL=whisper-large-v3
# (llama-3.3-70b-versatile was retired by Groq on 16 Aug 2026; the app also switches to a working
#  model by itself if a configured one disappears)
TEXT_MODEL=openai/gpt-oss-120b
MAX_UPLOAD_MB=25

# SETUP B — OpenAI (paid, per use): leave OPENAI_BASE_URL blank and use
#   OPENAI_API_KEY=sk-...   TRANSCRIBE_MODEL=whisper-1   TEXT_MODEL=gpt-4o-mini
#   MAX_UPLOAD_MB=25 (OpenAI's own limit for audio uploads)

# SETUP C — fully local, no account at all (your own computer or Colab; needs
#   `pip install faster-whisper "av<19"` and ffmpeg). Slower, and there are NO
#   AI insights in this mode (nothing to write them). Replace the lines above with:
#   TRANSCRIPTION_BACKEND=local
#   ANALYSIS_BACKEND=local
#   LOCAL_WHISPER_MODEL=small        # tiny/base/small/medium/large-v3; "small" is the floor
#   MAX_UPLOAD_MB=100

# ── Text -> Audio ───────────────────────────────────────────────────────
# auto = free Microsoft voices first, Google voices as a backup. (edge | gtts to force one.)
TTS_ENGINE=auto
# Longest text accepted on the Text -> Audio page, in characters (~30,000 = about 5,000 words)
MAX_TEXT_CHARS=30000

# ── Everything else ─────────────────────────────────────────────────────

# Where generated files (PDF/DOCX/JPEG) and temp audio are stored (created automatically)
STORAGE_DIR=./storage

# "Speaker 1 / Speaker 2" labels. Needs the optional pyannote.audio setup — see README "Speaker labels".
# When this is true (and the token is set) a "Label who is speaking" box on the options pages works.
ENABLE_DIARIZATION=false
HUGGINGFACE_TOKEN=

# Comma-separated list of origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000

# Sign-in. LEAVE BLANK for an open site (fine on your own computer, NOT for a public link).
# If set, the page asks each visitor for a key once and remembers it in their browser.
# One shared key:           ACCESS_KEY=mysecretword
# A key per person (best):  ACCESS_KEY=ravi=k7Hq2xPz,priya=Vb83nLmQ,guest=T5wYc9Ae
#   -> each person sees their own name and daily allowance, and you can cut one person off
#      by deleting just their entry. (Names: letters, digits, - _ . only.)
ACCESS_KEY=

# The most jobs ONE person (one key; or one IP address when there is no key) can start in 24 hours.
# 0 = unlimited. Set something like 20 before you share a public link — this is what stops
# strangers (or a runaway script) from using up your AI quota.
DAILY_JOB_LIMIT=0

# Read the visitor's real IP from the X-Forwarded-For header (right on Render, ngrok and Colab,
# where every request arrives via a proxy). Set false only if the app is exposed directly.
TRUST_PROXY=true

# Max requests per minute per IP address (protects your free-tier limits from hammering)
RATE_LIMIT_PER_MINUTE=10
